<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="20dp" android:paddingRight="20dp"
        android:paddingTop="12dp" android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView android:id="@+id/back"
                style="@style/IconBtn"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:src="@drawable/ic_back_s"/>

            <TextView android:id="@+id/title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="14dp"
                android:textSize="21sp"
                android:textColor="@color/text"
                android:fontFamily="sans-serif-medium"/>
        </LinearLayout>

        <TextView style="@style/FieldLabel" android:text="@string/fld_client"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="22dp" android:layout_marginBottom="7dp"/>

        <Spinner android:id="@+id/client_spinner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_input"
            android:paddingLeft="10dp" android:paddingRight="10dp"/>

        <TextView android:id="@+id/new_client_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:text="@string/new_client"
            android:textSize="13sp"
            android:textColor="@color/primary"
            android:fontFamily="sans-serif-medium"
            android:paddingTop="4dp" android:paddingBottom="4dp"
            android:background="?android:attr/selectableItemBackground"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <LinearLayout style="@style/DateCol"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView style="@style/FieldLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="7dp"
                    android:text="@string/fld_date"/>
                <TextView android:id="@+id/date_btn" style="@style/PickBtn"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"/>
            </LinearLayout>

            <Space android:layout_width="12dp" android:layout_height="1dp"/>

            <LinearLayout style="@style/DateCol"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView style="@style/FieldLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="7dp"
                    android:text="@string/fld_time"/>
                <TextView android:id="@+id/time_btn" style="@style/PickBtn"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"/>
            </LinearLayout>
        </LinearLayout>

        <TextView android:id="@+id/hint_past"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/past_hint"
            android:textSize="12sp"
            android:textColor="@color/secondary"
            android:visibility="gone"/>

        <TextView style="@style/FieldLabel" android:text="@string/fld_service"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:layout_marginBottom="7dp"/>

        <EditText android:id="@+id/service"
            style="@style/Input" android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/fld_service_hint"
            android:inputType="textCapSentences"
            android:singleLine="true"/>

        <TextView style="@style/FieldLabel" android:text="@string/fld_amount"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:layout_marginBottom="7dp"/>

        <EditText android:id="@+id/amount"
            style="@style/Input" android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:singleLine="true"/>

        <TextView style="@style/FieldLabel" android:text="@string/fld_paid"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:layout_marginBottom="7dp"/>

        <EditText android:id="@+id/paid"
            style="@style/Input" android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/fld_paid_hint"
            android:inputType="numberDecimal"
            android:singleLine="true"/>

        <TextView style="@style/FieldLabel" android:text="@string/fld_notes"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:layout_marginBottom="7dp"/>

        <EditText android:id="@+id/notes"
            style="@style/Input" android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minLines="2"
            android:gravity="top"
            android:hint="@string/fld_notes_hint"
            android:inputType="textMultiLine|textCapSentences"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="20dp">

            <Switch android:id="@+id/remind"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <ImageView
                android:layout_width="19dp" android:layout_height="19dp"
                android:layout_marginLeft="12dp"
                android:src="@drawable/ic_bell_s"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:text="@string/reminder_on"
                android:textSize="15sp"
                android:textColor="@color/text"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/status_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="20dp"
            android:visibility="gone">

            <TextView android:id="@+id/st_up" style="@style/ChipToggle"
                android:layout_width="0dp" android:layout_height="40dp"
                android:layout_weight="1" android:text="@string/status_upcoming"/>
            <Space android:layout_width="8dp" android:layout_height="1dp"/>
            <TextView android:id="@+id/st_done" style="@style/ChipToggle"
                android:layout_width="0dp" android:layout_height="40dp"
                android:layout_weight="1" android:text="@string/status_done"/>
            <Space android:layout_width="8dp" android:layout_height="1dp"/>
            <TextView android:id="@+id/st_canc" style="@style/ChipToggle"
                android:layout_width="0dp" android:layout_height="40dp"
                android:layout_weight="1" android:text="@string/status_cancelled"/>
        </LinearLayout>

        <Button android:id="@+id/save"
            style="@style/BtnPrimary"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="26dp"
            android:text="@string/save"/>

        <TextView android:id="@+id/delete_btn"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center"
            android:layout_marginTop="6dp"
            android:text="@string/delete"
            android:textSize="14sp"
            android:textColor="@color/danger"
            android:fontFamily="sans-serif-medium"
            android:background="?android:attr/selectableItemBackground"
            android:visibility="gone"/>
    </LinearLayout>
</ScrollView>
