<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <FrameLayout
        android:layout_width="30dp"
        android:layout_height="match_parent">

        <View android:id="@+id/rail_line"
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_line"/>

        <View
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:layout_gravity="center_horizontal|top"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_dot_appt"/>
    </FrameLayout>

    <LinearLayout android:id="@+id/card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginTop="4dp" android:layout_marginBottom="4dp"
        android:layout_marginRight="4dp"
        android:orientation="vertical"
        android:background="@drawable/bg_card"
        android:paddingLeft="14dp" android:paddingRight="10dp"
        android:paddingTop="10dp" android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView android:id="@+id/time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@color/text_sub"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.04"/>

            <Space android:layout_width="0dp" android:layout_height="1dp"
                android:layout_weight="1"/>

            <TextView android:id="@+id/next_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="6dp"
                android:paddingLeft="8dp" android:paddingRight="8dp"
                android:paddingTop="3dp" android:paddingBottom="3dp"
                android:text="@string/next_tag"
                android:textSize="10sp"
                android:visibility="gone"
                android:textColor="@color/on_secondary_container"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.08"
                android:background="@drawable/bg_settle"/>

            <TextView android:id="@+id/status_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="9dp" android:paddingRight="9dp"
                android:paddingTop="3dp" android:paddingBottom="3dp"
                android:textSize="10sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.06"/>
        </LinearLayout>

        <TextView android:id="@+id/client_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="16sp"
            android:textColor="@color/text"
            android:fontFamily="sans-serif-medium"
            android:singleLine="true"
            android:ellipsize="end"/>

        <TextView android:id="@+id/meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:textSize="13sp"
            android:textColor="@color/text_sub"
            android:singleLine="true"
            android:ellipsize="end"/>
    </LinearLayout>

    <ImageView android:id="@+id/more"
        android:layout_width="34dp"
        android:layout_height="match_parent"
        android:scaleType="center"
        android:src="@drawable/ic_dots_s"/>
</LinearLayout>
